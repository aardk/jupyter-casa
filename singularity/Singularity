Bootstrap: docker
From: ubuntu:24.04
IncludeCmd: no

%runscript
    echo "Starting Jupyter"
    jupyter notebook

%environment
    export PYTHONPATH="/usr/local/lib/python3.12/dist-packages"
    export QT_X11_NO_MITSHM=1
    unset XDG_RUNTIME_DIR 

%setup
    # Add jupyter-casa tree to container
    mkdir ${SINGULARITY_ROOTFS}/usr/local/jupyter-casa
    cp -r jupyter python ${SINGULARITY_ROOTFS}/usr/local/jupyter-casa
    mkdir -p ${SINGULARITY_ROOTFS}/opt/casa
    cp casasiteconfig.py ${SINGULARITY_ROOTFS}/opt/casa

%post
    # Setup enviroment
    export DEBIAN_FRONTEND=noninteractive
    #echo deb http://nl.archive.ubuntu.com/ubuntu/ noble main restricted universe multiverse >/etc/apt/sources.list
    #echo deb http://nl.archive.ubuntu.com/ubuntu/ noble-updates main restricted universe multiverse >>/etc/apt/sources.list

    export LC_ALL=C
    apt-get update && apt-get install -y apt-utils debconf-utils && apt-get upgrade -y
    apt-get install -y python3 python3-dev python3-pip libgfortran5 wget software-properties-common
    apt-get install -y git lsof xvfb vim nano emacs-nox curl libssl-dev
    # Nodejs
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - 
    apt-get install -y nodejs
    # Jupyterlab
    pip install --break-system-packages matplotlib~=3.10.7 astropy~=6.1.7 notebook~=7.5.6 widgetsnbextension~=4.0.14 ipywidgets~=8.1.7 jupyterhub~=5.4.1 jupyterlab~=4.5.7 bokeh>=3.8
    #jupyter nbextension enable --py widgetsnbextension --sys-prefix
    jupyter labextension install @jupyter-widgets/jupyterlab-manager
    # Install casa
    pip install --break-system-packages --extra-index-url https://casa-pip.nrao.edu/repository/pypi-casa-release/simple casatools==6.7.5.18 casatasks==6.7.5.18 casashell==6.7.5.18 casatestutils==6.7.5.18 casaplotserver==2.1.1 casatablebrowser==0.0.41 casafeather==0.0.28 casadata==2026.10.5 casaconfig==1.5.0 cubevis==1.0.21
    #
    # Plotms, casaviewer, and casalogger use appimage which from within singularity need 
    # root privaliges to mount due to SUID issues, as a work around we extract
    # the images and modify the casa tasks to call the extracted images
    pip install --break-system-packages --extra-index-url https://casa-pip.nrao.edu/repository/pypi-casa-release/simple casalogger==1.0.24
    cd /usr/local/lib/python3.12/dist-packages/casalogger/__bin__
    ./casalogger-x86_64.AppImage --appimage-extract
    rm casalogger-x86_64.AppImage
    find squashfs-root -type d | xargs chmod 775
    cd ..
    sed -i -e 's/casalogger-x86_64.AppImage/squashfs-root\/AppRun/' casalogger.py
    #
    pip install --break-system-packages --extra-index-url https://casa-pip.nrao.edu/repository/pypi-casa-release/simple casaplotms==2.9.1
    cd /usr/local/lib/python3.12/dist-packages/casaplotms/__bin__
    ./casaplotms-x86_64.AppImage --appimage-extract
    rm casaplotms-x86_64.AppImage
    find squashfs-root -type d | xargs chmod 775
    cd ..
    sed -i -e 's/casaplotms-x86_64.AppImage/squashfs-root\/AppRun/' private/plotmstool.py
    #
    pip install --break-system-packages --extra-index-url https://casa-pip.nrao.edu/repository/pypi-casa-release/simple casaviewer==2.4.4
    cd /usr/local/lib/python3.12/dist-packages/casaviewer/__bin__
    ./casaviewer-x86_64.AppImage --appimage-extract
    rm casaviewer-x86_64.AppImage
    find squashfs-root -type d | xargs chmod 775
    cd ..
    sed -i -e 's/casaviewer-x86_64.AppImage/squashfs-root\/AppRun/' private/config.py
    #
    #########################################
    # Most recent protobuf breaks plotms
    #########################################
    #
    pip install --break-system-packages protobuf==3.20.*
    #
    #########################################
    # Install WSCLEAN, AOFLAGGER, and CARTA
    #########################################
    #
    apt-add-repository -y -s ppa:kernsuite/kern-10
    apt-get install -y wsclean aoflagger
    #
    #########################################
    # JIVE VLBI Tools
    #########################################
    #
    git clone https://github.com/jive-vlbi/casa-vlbi 
    cp casa-vlbi/*py /usr/local/bin 
    cp -r casa-vlbi/casavlbitools /usr/local/lib/python3.12/dist-packages 
    rm -rf casa-vlbi
    #
    #########################################
    # Plotcalng
    #########################################
    #
    git clone https://github.com/aardk/evn-tools
    cp -r evn-tools/python/evn_tools /usr/local/lib/python3.12/dist-packages
    rm -rf evn-tools
    # evn_tools requires pyvo
    pip install --break-system-packages 'pyvo<=1.5.99'
    #
    #########################################
    # Useful packages 
    #########################################
    #
    pip install --break-system-packages natsort
    #
    #########################################
    # Jupyter-casa
    #########################################
    #
    cd /usr/local
    mkdir -p /usr/local/lib/python3.12/dist-packages
    mv jupyter-casa/python/start_casa /usr/local/lib/python3.12/dist-packages/
    cp -r jupyter-casa/jupyter /usr/local/share/
    # Modified casa tasks for Jupyter
    cd /usr/local
    patch lib/python3.12/dist-packages/casatasks/private/task_setjy.py jupyter-casa/python/casa/task_setjy.patch
